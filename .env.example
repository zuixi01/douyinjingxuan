# Vite reads this after copying to .env.local. VITE_* values are public.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Backend: set these in the shell before starting uvicorn.
# The backend does NOT automatically load .env files.
KNOWLEDGE_STORAGE_BACKEND=json
# KNOWLEDGE_DATA_DIR=/absolute/path/to/private/data
# SQLite alternative: KNOWLEDGE_STORAGE_BACKEND=database
# DATABASE_URL=sqlite:////absolute/path/to/private/data/knowledge.db
KNOWLEDGE_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
