	"transcription": [
		{
			"timestamps": {
				"from": "00:00:00,000",
				"to": "00:00:03,400"
			},
			"offsets": {
				"from": 0,
				"to": 3400
			},
			"text": "达尔文写下了这辈子最恶毒的诅咒"
		},
		{
			"timestamps": {
				"from": "00:00:03,400",
				"to": "00:00:06,680"
			},
			"offsets": {
				"from": 3400,
				"to": 6680
			},
			"text": "我要把这份增物与彼氏刻进骨头里"
		},
		{
			"timestamps": {
				"from": "00:00:06,680",
				"to": "00:00:09,200"
			},
			"offsets": {
				"from": 6680,
				"to": 9200
			},
			"text": "直到生命的最后一日"
		},
		{
			"timestamps": {
				"from": "00:00:09,200",
				"to": "00:00:10,520"
			},
			"offsets": {
				"from": 9200,
				"to": 10520
			},
			"text": "它一辈子温和"
		},
		{
			"timestamps": {
				"from": "00:00:10,520",
				"to": "00:00:13,000"
			},
			"offsets": {
				"from": 10520,
				"to": 13000
			},
			"text": "但只有一人让它深恶痛绝"
		},
		{
			"timestamps": {
				"from": "00:00:13,000",
				"to": "00:00:14,120"
			},
			"offsets": {
				"from": 13000,
				"to": 14120
			},
			"text": "黎查德欧文"
		},
		{
			"timestamps": {
				"from": "00:00:14,120",
				"to": "00:00:16,720"
			},
			"offsets": {
				"from": 14120,
				"to": 16720
			},
			"text": "那个发明了恐龙一词的人"
		},
		{
			"timestamps": {
				"from": "00:00:16,720",
				"to": "00:00:18,680"
			},
			"offsets": {
				"from": 16720,
				"to": 18680
			},
			"text": "欧文拥有神异般的天赋"
		},
		{
			"timestamps": {
				"from": "00:00:18,680",
				"to": "00:00:20,000"
			},
			"offsets": {
				"from": 18680,
				"to": 20000
			},
			"text": "仅凭一块残骨"
		},
		{
			"timestamps": {
				"from": "00:00:20,000",
				"to": "00:00:22,560"
			},
			"offsets": {
				"from": 20000,
				"to": 22560
			},
			"text": "就能精准预言一只远古巨鸟"
		},
		{
			"timestamps": {
				"from": "00:00:22,560",
				"to": "00:00:25,440"
			},
			"offsets": {
				"from": 22560,
				"to": 25440
			},
			"text": "但它偏偏是一头被全力吞噬的野兽"
		},
		{
			"timestamps": {
				"from": "00:00:25,440",
				"to": "00:00:28,880"
			},
			"offsets": {
				"from": 25440,
				"to": 28880
			},
			"text": "连别人骨头上的名字都要声声啃掉"
		},
		{
			"timestamps": {
				"from": "00:00:28,880",
				"to": "00:00:30,960"
			},
			"offsets": {
				"from": 28880,
				"to": 30960
			},
			"text": "19世纪初的英国科学界"
		},
		{
			"timestamps": {
				"from": "00:00:30,960",
				"to": "00:00:33,760"
			},
			"offsets": {
				"from": 30960,
				"to": 33760
			},
			"text": "是贵族和富豪的封闭俱乐部"
		},
		{
			"timestamps": {
				"from": "00:00:33,760",
				"to": "00:00:35,920"
			},
			"offsets": {
				"from": 33760,
				"to": 35920
			},
			"text": "乡村医生吉迪恩·曼特尔"
		},
		{
			"timestamps": {
				"from": "00:00:35,920",
				"to": "00:00:37,560"
			},
			"offsets": {
				"from": 35920,
				"to": 37560
			},
			"text": "注定是个局外人"
		},
		{
			"timestamps": {
				"from": "00:00:37,560",
				"to": "00:00:38,240"
			},
			"offsets": {
				"from": 37560,
				"to": 38240
			},
			"text": "白天"
		},
		{
			"timestamps": {
				"from": "00:00:38,240",
				"to": "00:00:40,920"
			},
			"offsets": {
				"from": 38240,
				"to": 40920
			},
			"text": "他在泥泞中奔波看诊"
		},
		{
			"timestamps": {
				"from": "00:00:40,920",
				"to": "00:00:41,600"
			},
			"offsets": {
				"from": 40920,
				"to": 41600
			},
			"text": "深夜"
		},
		{
			"timestamps": {
				"from": "00:00:41,600",
				"to": "00:00:44,720"
			},
			"offsets": {
				"from": 41600,
				"to": 44720
			},
			"text": "他在地下室敲打着冰冷的石头"
		},
		{
			"timestamps": {
				"from": "00:00:44,720",
				"to": "00:00:46,240"
			},
			"offsets": {
				"from": 44720,
				"to": 46240
			},
			"text": "182年"
		},
		{
			"timestamps": {
				"from": "00:00:46,240",
				"to": "00:00:50,240"
			},
			"offsets": {
				"from": 46240,
				"to": 50240
			},
			"text": "曼特尔收到一枚妻子无意捡到的褐色牙齿"
		},
		{
			"timestamps": {
				"from": "00:00:50,240",
				"to": "00:00:51,760"
			},
			"offsets": {
				"from": 50240,
				"to": 51760
			},
			"text": "擦去泥土的瞬间"
		},
		{
			"timestamps": {
				"from": "00:00:51,760",
				"to": "00:00:52,920"
			},
			"offsets": {
				"from": 51760,
				"to": 52920
			},
			"text": "它浑身占力"
		},
		{
			"timestamps": {
				"from": "00:00:52,920",
				"to": "00:00:54,400"
			},
			"offsets": {
				"from": 52920,
				"to": 54400
			},
			"text": "这东西太怪了"
		},
		{
			"timestamps": {
				"from": "00:00:54,400",
				"to": "00:00:56,480"
			},
			"offsets": {
				"from": 54400,
				"to": 56480
			},
			"text": "边缘像肉食动物的刀口"
		},
		{
			"timestamps": {
				"from": "00:00:56,480",
				"to": "00:00:59,520"
			},
			"offsets": {
				"from": 56480,
				"to": 59520
			},
			"text": "却又磨出了值食动物才有的皮面"
		},
		{
			"timestamps": {
				"from": "00:00:59,520",
				"to": "00:01:02,600"
			},
			"offsets": {
				"from": 59520,
				"to": 62600
			},
			"text": "当时被誉为亚里士多德第二的居维叶判定说"
		},
		{
			"timestamps": {
				"from": "00:01:02,600",
				"to": "00:01:04,480"
			},
			"offsets": {
				"from": 62600,
				"to": 64480
			},
			"text": "这不过是犀牛牙"
		},
		{
			"timestamps": {
				"from": "00:01:04,480",
				"to": "00:01:06,000"
			},
			"offsets": {
				"from": 64480,
				"to": 66000
			},
			"text": "但曼特尔不甘心"
		},
		{
			"timestamps": {
				"from": "00:01:06,000",
				"to": "00:01:07,320"
			},
			"offsets": {
				"from": 66000,
				"to": 67320
			},
			"text": "苦苦比对数年"
		},
		{
			"timestamps": {
				"from": "00:01:07,320",
				"to": "00:01:10,720"
			},
			"offsets": {
				"from": 67320,
				"to": 70720
			},
			"text": "终于在南美洲劣兮的骨架上找到了同款"
		},
		{
			"timestamps": {
				"from": "00:01:10,720",
				"to": "00:01:14,160"
			},
			"offsets": {
				"from": 70720,
				"to": 74160
			},
			"text": "只是这颗牙足有劣兮的二十倍大"
		},
		{
			"timestamps": {
				"from": "00:01:14,160",
				"to": "00:01:15,680"
			},
			"offsets": {
				"from": 74160,
				"to": 75680
			},
			"text": "这地上没有一只蝴蝶"
		},
		{
			"timestamps": {
				"from": "00:01:15,680",
				"to": "00:01:18,960"
			},
			"offsets": {
				"from": 75680,
				"to": 78960
			},
			"text": "能够成长到如此巨大的大小"
		},
		{
			"timestamps": {
				"from": "00:01:18,960",
				"to": "00:01:20,640"
			},
			"offsets": {
				"from": 78960,
				"to": 80640
			},
			"text": "一个念头击中了他"
		},
		{
			"timestamps": {
				"from": "00:01:20,640",
				"to": "00:01:22,000"
			},
			"offsets": {
				"from": 80640,
				"to": 82000
			},
			"text": "一年前的英国"
		},
		{
			"timestamps": {
				"from": "00:01:22,000",
				"to": "00:01:25,640"
			},
			"offsets": {
				"from": 82000,
				"to": 85640
			},
			"text": "曾游荡着一种身长十米的史前巨兽"
		},
		{
			"timestamps": {
				"from": "00:01:25,640",
				"to": "00:01:26,760"
			},
			"offsets": {
				"from": 85640,
				"to": 86760
			},
			"text": "1825年"
		},
		{
			"timestamps": {
				"from": "00:01:26,760",
				"to": "00:01:30,120"
			},
			"offsets": {
				"from": 86760,
				"to": 90120
			},
			"text": "他将其命名为劣兮枝牙秦龙"
		},
		{
			"timestamps": {
				"from": "00:01:30,120",
				"to": "00:01:33,440"
			},
			"offsets": {
				"from": 90120,
				"to": 93440
			},
			"text": "曼特尔以为凭此就能机身科学界"
		},
		{
			"timestamps": {
				"from": "00:01:33,440",
				"to": "00:01:34,320"
			},
			"offsets": {
				"from": 93440,
				"to": 94320
			},
			"text": "但他忘了"
		},
		{
			"timestamps": {
				"from": "00:01:34,320",
				"to": "00:01:35,680"
			},
			"offsets": {
				"from": 94320,
				"to": 95680
			},
			"text": "新世界的入口"
		},
		{
			"timestamps": {
				"from": "00:01:35,680",
				"to": "00:01:38,240"
			},
			"offsets": {
				"from": 95680,
				"to": 98240
			},
			"text": "死死攥在那个封闭俱乐部手里"
		},
		{
			"timestamps": {
				"from": "00:01:38,240",
				"to": "00:01:39,880"
			},
			"offsets": {
				"from": 98240,
				"to": 99880
			},
			"text": "掌门人李查德·欧文"
		},
		{
			"timestamps": {
				"from": "00:01:39,880",
				"to": "00:01:41,600"
			},
			"offsets": {
				"from": 99880,
				"to": 101600
			},
			"text": "这位给女王孩子上课"
		},
		{
			"timestamps": {
				"from": "00:01:41,600",
				"to": "00:01:44,240"
			},
			"offsets": {
				"from": 101600,
				"to": 104240
			},
			"text": "与狄更斯称兄道弟的学界全臣"
		},
		{
			"timestamps": {
				"from": "00:01:44,240",
				"to": "00:01:47,520"
			},
			"offsets": {
				"from": 104240,
				"to": 107520
			},
			"text": "绝不允许乡下医生染指自己的王座"
		},
		{
			"timestamps": {
				"from": "00:01:47,520",
				"to": "00:01:48,720"
			},
			"offsets": {
				"from": 107520,
				"to": 108720
			},
			"text": "1841年"
		},
		{
			"timestamps": {
				"from": "00:01:48,720",
				"to": "00:01:51,040"
			},
			"offsets": {
				"from": 108720,
				"to": 111040
			},
			"text": "欧文在科学大会上发表演讲"
		},
		{
			"timestamps": {
				"from": "00:01:51,040",
				"to": "00:01:53,560"
			},
			"offsets": {
				"from": 111040,
				"to": 113560
			},
			"text": "傲慢地淡化了曼特尔的功劳"
		},
		{
			"timestamps": {
				"from": "00:01:53,560",
				"to": "00:01:54,480"
			},
			"offsets": {
				"from": 113560,
				"to": 114480
			},
			"text": "六个月后"
		},
		{
			"timestamps": {
				"from": "00:01:54,480",
				"to": "00:01:56,560"
			},
			"offsets": {
				"from": 114480,
				"to": 116560
			},
			"text": "他在出版的演讲搞角助理"
		},
		{
			"timestamps": {
				"from": "00:01:56,560",
				"to": "00:01:58,400"
			},
			"offsets": {
				"from": 116560,
				"to": 118400
			},
			"text": "偷偷塞进了一个会场上"
		},
		{
			"timestamps": {
				"from": "00:01:58,400",
				"to": "00:01:59,920"
			},
			"offsets": {
				"from": 118400,
				"to": 119920
			},
			"text": "根本没说过的词"
		},
		{
			"timestamps": {
				"from": "00:01:59,920",
				"to": "00:02:00,600"
			},
			"offsets": {
				"from": 119920,
				"to": 120600
			},
			"text": "恐龙"
		},
		{
			"timestamps": {
				"from": "00:02:00,600",
				"to": "00:02:02,720"
			},
			"offsets": {
				"from": 120600,
				"to": 122720
			},
			"text": "一位令人敬畏的蜥蜴"
		},
		{
			"timestamps": {
				"from": "00:02:02,720",
				"to": "00:02:05,160"
			},
			"offsets": {
				"from": 122720,
				"to": 125160
			},
			"text": "这是一场阴险的学术掠夺"
		},
		{
			"timestamps": {
				"from": "00:02:05,160",
				"to": "00:02:06,640"
			},
			"offsets": {
				"from": 125160,
				"to": 126640
			},
			"text": "欧文用这个新词"
		},
		{
			"timestamps": {
				"from": "00:02:06,640",
				"to": "00:02:09,320"
			},
			"offsets": {
				"from": 126640,
				"to": 129320
			},
			"text": "将曼特尔等人的发现强行打包"
		},
		{
			"timestamps": {
				"from": "00:02:09,320",
				"to": "00:02:10,000"
			},
			"offsets": {
				"from": 129320,
				"to": 130000
			},
			"text": "最后"
		},
		{
			"timestamps": {
				"from": "00:02:10,000",
				"to": "00:02:11,320"
			},
			"offsets": {
				"from": 130000,
				"to": 131320
			},
			"text": "欧文动用霸权"
		},
		{
			"timestamps": {
				"from": "00:02:11,320",
				"to": "00:02:13,320"
			},
			"offsets": {
				"from": 131320,
				"to": 133320
			},
			"text": "全面封杀曼特尔的论文"
		},
		{
			"timestamps": {
				"from": "00:02:13,320",
				"to": "00:02:14,360"
			},
			"offsets": {
				"from": 133320,
				"to": 134360
			},
			"text": "在公开场合"
		},
		{
			"timestamps": {
				"from": "00:02:14,360",
				"to": "00:02:16,640"
			},
			"offsets": {
				"from": 134360,
				"to": 136640
			},
			"text": "把秦龙的发现据为己有"
		},
		{
			"timestamps": {
				"from": "00:02:16,640",
				"to": "00:02:17,400"
			},
			"offsets": {
				"from": 136640,
				"to": 137400
			},
			"text": "从此"
		},
		{
			"timestamps": {
				"from": "00:02:17,400",
				"to": "00:02:18,960"
			},
			"offsets": {
				"from": 137400,
				"to": 138960
			},
			"text": "曼特尔发现的骨头"
		},
		{
			"timestamps": {
				"from": "00:02:18,960",
				"to": "00:02:21,280"
			},
			"offsets": {
				"from": 138960,
				"to": 141280
			},
			"text": "变成了欧文命名的王国"
		},
		{
			"timestamps": {
				"from": "00:02:21,280",
				"to": "00:02:23,040"
			},
			"offsets": {
				"from": 141280,
				"to": 143040
			},
			"text": "公众只记住了恐龙"
		},
		{
			"timestamps": {
				"from": "00:02:23,040",
				"to": "00:02:24,760"
			},
			"offsets": {
				"from": 143040,
				"to": 144760
			},
			"text": "欧文也就顺理成章地"
		},
		{
			"timestamps": {
				"from": "00:02:24,760",
				"to": "00:02:26,800"
			},
			"offsets": {
				"from": 144760,
				"to": 146800
			},
			"text": "成了恐龙之父"
		},
		{
			"timestamps": {
				"from": "00:02:26,800",
				"to": "00:02:27,480"
			},
			"offsets": {
				"from": 146800,
				"to": 147480
			},
			"text": "同年"
		},
		{
			"timestamps": {
				"from": "00:02:27,480",
				"to": "00:02:30,040"
			},
			"offsets": {
				"from": 147480,
				"to": 150040
			},
			"text": "命运也对曼特尔露出了牙"
		},
		{
			"timestamps": {
				"from": "00:02:30,040",
				"to": "00:02:31,600"
			},
			"offsets": {
				"from": 150040,
				"to": 151600
			},
			"text": "在一次马车事故中"
		},
		{
			"timestamps": {
				"from": "00:02:31,600",
				"to": "00:02:33,080"
			},
			"offsets": {
				"from": 151600,
				"to": 153080
			},
			"text": "他摔断了脊椎"
		},
		{
			"timestamps": {
				"from": "00:02:33,080",
				"to": "00:02:34,280"
			},
			"offsets": {
				"from": 153080,
				"to": 154280
			},
			"text": "此后十一年"
		},
		{
			"timestamps": {
				"from": "00:02:34,280",
				"to": "00:02:35,800"
			},
			"offsets": {
				"from": 154280,
				"to": 155800
			},
			"text": "只能靠吸食鸦片"
		},
		{
			"timestamps": {
				"from": "00:02:35,800",
				"to": "00:02:37,480"
			},
			"offsets": {
				"from": 155800,
				"to": 157480
			},
			"text": "在巨铜中苟活"
		},
		{
			"timestamps": {
				"from": "00:02:37,480",
				"to": "00:02:39,600"
			},
			"offsets": {
				"from": 157480,
				"to": 159600
			},
			"text": "最终死于鸦片过量"
		},
		{
			"timestamps": {
				"from": "00:02:39,600",
				"to": "00:02:40,440"
			},
			"offsets": {
				"from": 159600,
				"to": 160440
			},
			"text": "几天后"
		},
		{
			"timestamps": {
				"from": "00:02:40,440",
				"to": "00:02:42,160"
			},
			"offsets": {
				"from": 160440,
				"to": 162160
			},
			"text": "欧文纸笔匿名复告"
		},
		{
			"timestamps": {
				"from": "00:02:42,160",
				"to": "00:02:44,840"
			},
			"offsets": {
				"from": 162160,
				"to": 164840
			},
			"text": "将他朝贬为卑微的化石搬运工"
		},
		{
			"timestamps": {
				"from": "00:02:44,840",
				"to": "00:02:46,200"
			},
			"offsets": {
				"from": 164840,
				"to": 166200
			},
			"text": "这还不是尽头"
		},
		{
			"timestamps": {
				"from": "00:02:46,200",
				"to": "00:02:47,840"
			},
			"offsets": {
				"from": 166200,
				"to": 167840
			},
			"text": "欧文以科学研究为名"
		},
		{
			"timestamps": {
				"from": "00:02:47,840",
				"to": "00:02:49,360"
			},
			"offsets": {
				"from": 167840,
				"to": 169360
			},
			"text": "派人切下了曼特尔那根"
		},
		{
			"timestamps": {
				"from": "00:02:49,360",
				"to": "00:02:50,880"
			},
			"offsets": {
				"from": 169360,
				"to": 170880
			},
			"text": "严重病变的脊柱"
		},
		{
			"timestamps": {
				"from": "00:02:50,880",
				"to": "00:02:51,560"
			},
			"offsets": {
				"from": 170880,
				"to": 171560
			},
			"text": "作为标本"
		},
		{
			"timestamps": {
				"from": "00:02:51,560",
				"to": "00:02:54,160"
			},
			"offsets": {
				"from": 171560,
				"to": 174160
			},
			"text": "陈列在了自己管辖的博物馆里"
		},
		{
			"timestamps": {
				"from": "00:02:54,160",
				"to": "00:02:55,240"
			},
			"offsets": {
				"from": 174160,
				"to": 175240
			},
			"text": "曼特尔死后"
		},
		{
			"timestamps": {
				"from": "00:02:55,240",
				"to": "00:02:58,320"
			},
			"offsets": {
				"from": 175240,
				"to": 178320
			},
			"text": "欧文彻底接管了恐龙的解释权"
		},
		{
			"timestamps": {
				"from": "00:02:58,320",
				"to": "00:02:59,560"
			},
			"offsets": {
				"from": 178320,
				"to": 179560
			},
			"text": "曼特尔曾推测"
		},
		{
			"timestamps": {
				"from": "00:02:59,560",
				"to": "00:03:00,840"
			},
			"offsets": {
				"from": 179560,
				"to": 180840
			},
			"text": "秦龙前肢短小"
		},
		{
			"timestamps": {
				"from": "00:03:00,840",
				"to": "00:03:03,120"
			},
			"offsets": {
				"from": 180840,
				"to": 183120
			},
			"text": "应该是两足占力的"
		},
		{
			"timestamps": {
				"from": "00:03:03,120",
				"to": "00:03:05,000"
			},
			"offsets": {
				"from": 183120,
				"to": 185000
			},
			"text": "当时演化论正在萌芽"
		},
		{
			"timestamps": {
				"from": "00:03:05,000",
				"to": "00:03:07,080"
			},
			"offsets": {
				"from": 185000,
				"to": 187080
			},
			"text": "如果恐龙像鸟一样占力"
		},
		{
			"timestamps": {
				"from": "00:03:07,080",
				"to": "00:03:09,080"
			},
			"offsets": {
				"from": 187080,
				"to": 189080
			},
			"text": "就成了物种净化的铁证"
		},
		{
			"timestamps": {
				"from": "00:03:09,080",
				"to": "00:03:11,400"
			},
			"offsets": {
				"from": 189080,
				"to": 191400
			},
			"text": "但欧文绝不允许"
		},
		{
			"timestamps": {
				"from": "00:03:11,400",
				"to": "00:03:14,560"
			},
			"offsets": {
				"from": 191400,
				"to": 194560
			},
			"text": "欧文的王座靠的是教会和贵族支持"
		},
		{
			"timestamps": {
				"from": "00:03:14,560",
				"to": "00:03:15,720"
			},
			"offsets": {
				"from": 194560,
				"to": 195720
			},
			"text": "他必须死守物种"
		},
		{
			"timestamps": {
				"from": "00:03:15,720",
				"to": "00:03:17,320"
			},
			"offsets": {
				"from": 195720,
				"to": 197320
			},
			"text": "由上帝单独创造"
		},
		{
			"timestamps": {
				"from": "00:03:17,320",
				"to": "00:03:19,440"
			},
			"offsets": {
				"from": 197320,
				"to": 199440
			},
			"text": "彼此毫无关联的底线"
		},
		{
			"timestamps": {
				"from": "00:03:19,440",
				"to": "00:03:22,120"
			},
			"offsets": {
				"from": 199440,
				"to": 202120
			},
			"text": "所以他强行把秦龙按在地上"
		},
		{
			"timestamps": {
				"from": "00:03:22,120",
				"to": "00:03:23,520"
			},
			"offsets": {
				"from": 202120,
				"to": 203520
			},
			"text": "复原成四角着地"
		},
		{
			"timestamps": {
				"from": "00:03:23,520",
				"to": "00:03:26,000"
			},
			"offsets": {
				"from": 203520,
				"to": 206000
			},
			"text": "像犀牛一样笨重的怪物"
		},
		{
			"timestamps": {
				"from": "00:03:26,000",
				"to": "00:03:27,040"
			},
			"offsets": {
				"from": 206000,
				"to": 207040
			},
			"text": "以此证明"
		},
		{
			"timestamps": {
				"from": "00:03:27,040",
				"to": "00:03:30,160"
			},
			"offsets": {
				"from": 207040,
				"to": 210160
			},
			"text": "他们只是上帝随手捏造的大号爬虫"
		},
		{
			"timestamps": {
				"from": "00:03:30,160",
				"to": "00:03:31,600"
			},
			"offsets": {
				"from": 210160,
				"to": 211600
			},
			"text": "他需要一场仪式"
		},
		{
			"timestamps": {
				"from": "00:03:31,600",
				"to": "00:03:35,200"
			},
			"offsets": {
				"from": 211600,
				"to": 215200
			},
			"text": "把谎言定死在公众的视觉信仰里"
		},
		{
			"timestamps": {
				"from": "00:03:35,200",
				"to": "00:03:36,360"
			},
			"offsets": {
				"from": 215200,
				"to": 216360
			},
			"text": "1853年"
		},
		{
			"timestamps": {
				"from": "00:03:36,360",
				"to": "00:03:37,480"
			},
			"offsets": {
				"from": 216360,
				"to": 217480
			},
			"text": "水晶公公园"
		},
		{
			"timestamps": {
				"from": "00:03:37,480",
				"to": "00:03:41,120"
			},
			"offsets": {
				"from": 217480,
				"to": 221120
			},
			"text": "一只长九米的秦龙水泥蛆鞘还没封顶"
		},
		{
			"timestamps": {
				"from": "00:03:41,120",
				"to": "00:03:45,240"
			},
			"offsets": {
				"from": 221120,
				"to": 225240
			},
			"text": "欧文在他的肚子里办了一场隆重的晚宴"
		},
		{
			"timestamps": {
				"from": "00:03:45,240",
				"to": "00:03:48,240"
			},
			"offsets": {
				"from": 225240,
				"to": 228240
			},
			"text": "顶流绅士们爬进巨兽体内"
		},
		{
			"timestamps": {
				"from": "00:03:48,240",
				"to": "00:03:50,200"
			},
			"offsets": {
				"from": 228240,
				"to": 230200
			},
			"text": "欧文坐在大脑的位置上"
		},
		{
			"timestamps": {
				"from": "00:03:50,200",
				"to": "00:03:53,000"
			},
			"offsets": {
				"from": 230200,
				"to": 233000
			},
			"text": "举杯向已故的曼特尔先生致敬"
		},
		{
			"timestamps": {
				"from": "00:03:53,000",
				"to": "00:03:54,800"
			},
			"offsets": {
				"from": 233000,
				"to": 234800
			},
			"text": "欧文在死敌的尸骨上"
		},
		{
			"timestamps": {
				"from": "00:03:54,800",
				"to": "00:03:56,840"
			},
			"offsets": {
				"from": 234800,
				"to": 236840
			},
			"text": "用这句错误的水泥雕塑"
		},
		{
			"timestamps": {
				"from": "00:03:56,840",
				"to": "00:03:59,440"
			},
			"offsets": {
				"from": 236840,
				"to": 239440
			},
			"text": "完成了最虚伪的加冕"
		},
		{
			"timestamps": {
				"from": "00:03:59,440",
				"to": "00:04:00,720"
			},
			"offsets": {
				"from": 239440,
				"to": 240720
			},
			"text": "当晚宴散去"
		},
		{
			"timestamps": {
				"from": "00:04:00,720",
				"to": "00:04:03,400"
			},
			"offsets": {
				"from": 240720,
				"to": 243400
			},
			"text": "欧文独自站在庞大的阴影下时"
		},
		{
			"timestamps": {
				"from": "00:04:03,400",
				"to": "00:04:05,560"
			},
			"offsets": {
				"from": 243400,
				"to": 245560
			},
			"text": "一丝恐惧厥住了他"
		},
		{
			"timestamps": {
				"from": "00:04:05,560",
				"to": "00:04:06,840"
			},
			"offsets": {
				"from": 245560,
				"to": 246840
			},
			"text": "真实的白鳄计"
		},
		{
			"timestamps": {
				"from": "00:04:06,840",
				"to": "00:04:08,480"
			},
			"offsets": {
				"from": 246840,
				"to": 248480
			},
			"text": "随时会冲破水泥"
		},
		{
			"timestamps": {
				"from": "00:04:08,480",
				"to": "00:04:11,000"
			},
			"offsets": {
				"from": 248480,
				"to": 251000
			},
			"text": "那只两足秦龙将踏过灌木"
		},
		{
			"timestamps": {
				"from": "00:04:11,000",
				"to": "00:04:14,200"
			},
			"offsets": {
				"from": 251000,
				"to": 254200
			},
			"text": "一口咬碎他构建的上帝秩序"
		},
		{
			"timestamps": {
				"from": "00:04:14,200",
				"to": "00:04:15,440"
			},
			"offsets": {
				"from": 254200,
				"to": 255440
			},
			"text": "为了镇压恐惧"
		},
		{
			"timestamps": {
				"from": "00:04:15,440",
				"to": "00:04:18,680"
			},
			"offsets": {
				"from": 255440,
				"to": 258680
			},
			"text": "他亲自设计了伦敦自然历史博物馆"
		},
		{
			"timestamps": {
				"from": "00:04:18,680",
				"to": "00:04:20,560"
			},
			"offsets": {
				"from": 258680,
				"to": 260560
			},
			"text": "他下令东一方灭绝物种"
		},
		{
			"timestamps": {
				"from": "00:04:20,560",
				"to": "00:04:22,200"
			},
			"offsets": {
				"from": 260560,
				"to": 262200
			},
			"text": "西一方限存物种"
		},
		{
			"timestamps": {
				"from": "00:04:22,200",
				"to": "00:04:23,680"
			},
			"offsets": {
				"from": 262200,
				"to": 263680
			},
			"text": "绝不混杂"
		},
		{
			"timestamps": {
				"from": "00:04:23,680",
				"to": "00:04:25,840"
			},
			"offsets": {
				"from": 263680,
				"to": 265840
			},
			"text": "他要把上帝的两次独立创造"
		},
		{
			"timestamps": {
				"from": "00:04:25,840",
				"to": "00:04:26,880"
			},
			"offsets": {
				"from": 265840,
				"to": 266880
			},
			"text": "完全隔开"
		},
		{
			"timestamps": {
				"from": "00:04:26,880",
				"to": "00:04:28,920"
			},
			"offsets": {
				"from": 266880,
				"to": 268920
			},
			"text": "永远刻进墙里"
		},
		{
			"timestamps": {
				"from": "00:04:28,920",
				"to": "00:04:32,000"
			},
			"offsets": {
				"from": 268920,
				"to": 272000
			},
			"text": "但欧文的墙挡不住达尔文"
		},
		{
			"timestamps": {
				"from": "00:04:32,000",
				"to": "00:04:34,760"
			},
			"offsets": {
				"from": 272000,
				"to": 274760
			},
			"text": "1859年物种起源初版"
		},
		{
			"timestamps": {
				"from": "00:04:34,760",
				"to": "00:04:37,440"
			},
			"offsets": {
				"from": 274760,
				"to": 277440
			},
			"text": "达尔文按惯例给欧文寄了一本"
		},
		{
			"timestamps": {
				"from": "00:04:37,440",
				"to": "00:04:38,800"
			},
			"offsets": {
				"from": 277440,
				"to": 278800
			},
			"text": "两人本是老友"
		},
		{
			"timestamps": {
				"from": "00:04:38,800",
				"to": "00:04:42,160"
			},
			"offsets": {
				"from": 278800,
				"to": 282160
			},
			"text": "达尔文当年从小猎犬号带回的南美化石"
		},
		{
			"timestamps": {
				"from": "00:04:42,160",
				"to": "00:04:44,720"
			},
			"offsets": {
				"from": 282160,
				"to": 284720
			},
			"text": "正是欧文亲手命名"
		},
		{
			"timestamps": {
				"from": "00:04:44,720",
				"to": "00:04:45,960"
			},
			"offsets": {
				"from": 284720,
				"to": 285960
			},
			"text": "欧文收到书后"
		},
		{
			"timestamps": {
				"from": "00:04:45,960",
				"to": "00:04:47,400"
			},
			"offsets": {
				"from": 285960,
				"to": 287400
			},
			"text": "笑咪咪地劝达尔文"
		},
		{
			"timestamps": {
				"from": "00:04:47,400",
				"to": "00:04:49,560"
			},
			"offsets": {
				"from": 287400,
				"to": 289560
			},
			"text": "保留我认为这种主观措辞"
		},
		{
			"timestamps": {
				"from": "00:04:49,560",
				"to": "00:04:50,760"
			},
			"offsets": {
				"from": 289560,
				"to": 290760
			},
			"text": "谁知一转身"
		},
		{
			"timestamps": {
				"from": "00:04:50,760",
				"to": "00:04:52,760"
			},
			"offsets": {
				"from": 290760,
				"to": 292760
			},
			"text": "他竟写下一篇匿名长文"
		},
		{
			"timestamps": {
				"from": "00:04:52,760",
				"to": "00:04:54,720"
			},
			"offsets": {
				"from": 292760,
				"to": 294720
			},
			"text": "一边大骂达尔文极不科学"
		},
		{
			"timestamps": {
				"from": "00:04:54,720",
				"to": "00:04:58,800"
			},
			"offsets": {
				"from": 294720,
				"to": 298800
			},
			"text": "一边厚颜无耻地大断赞美欧文教授的伟大"
		},
		{
			"timestamps": {
				"from": "00:04:58,800",
				"to": "00:05:01,080"
			},
			"offsets": {
				"from": 298800,
				"to": 301080
			},
			"text": "他觉得能像年死曼特尔一样"
		},
		{
			"timestamps": {
				"from": "00:05:01,080",
				"to": "00:05:03,240"
			},
			"offsets": {
				"from": 301080,
				"to": 303240
			},
			"text": "把演化论也一脚踩碎"
		},
		{
			"timestamps": {
				"from": "00:05:03,240",
				"to": "00:05:04,360"
			},
			"offsets": {
				"from": 303240,
				"to": 304360
			},
			"text": "1860年"
		},
		{
			"timestamps": {
				"from": "00:05:04,360",
				"to": "00:05:05,640"
			},
			"offsets": {
				"from": 304360,
				"to": 305640
			},
			"text": "牛津举办了一次"
		},
		{
			"timestamps": {
				"from": "00:05:05,640",
				"to": "00:05:09,440"
			},
			"offsets": {
				"from": 305640,
				"to": 309440
			},
			"text": "决定演化论生死的世纪大辩论"
		},
		{
			"timestamps": {
				"from": "00:05:09,440",
				"to": "00:05:10,640"
			},
			"offsets": {
				"from": 309440,
				"to": 310640
			},
			"text": "欧文放出狠话"
		},
		{
			"timestamps": {
				"from": "00:05:10,640",
				"to": "00:05:11,880"
			},
			"offsets": {
				"from": 310640,
				"to": 311880
			},
			"text": "要达尔文好看"
		},
		{
			"timestamps": {
				"from": "00:05:11,880",
				"to": "00:05:13,600"
			},
			"offsets": {
				"from": 311880,
				"to": 313600
			},
			"text": "临阵却又爱惜羽毛"
		},
		{
			"timestamps": {
				"from": "00:05:13,600",
				"to": "00:05:15,320"
			},
			"offsets": {
				"from": 313600,
				"to": 315320
			},
			"text": "却与当众对峙"
		},
		{
			"timestamps": {
				"from": "00:05:15,320",
				"to": "00:05:16,400"
			},
			"offsets": {
				"from": 315320,
				"to": 316400
			},
			"text": "他隐身幕后"
		},
		{
			"timestamps": {
				"from": "00:05:16,400",
				"to": "00:05:20,120"
			},
			"offsets": {
				"from": 316400,
				"to": 320120
			},
			"text": "把精心编排的恶毒台词赛给牛津主教"
		},
		{
			"timestamps": {
				"from": "00:05:20,120",
				"to": "00:05:21,080"
			},
			"offsets": {
				"from": 320120,
				"to": 321080
			},
			"text": "辩论场上"
		},
		{
			"timestamps": {
				"from": "00:05:21,080",
				"to": "00:05:22,480"
			},
			"offsets": {
				"from": 321080,
				"to": 322480
			},
			"text": "主教居高临下"
		},
		{
			"timestamps": {
				"from": "00:05:22,480",
				"to": "00:05:24,440"
			},
			"offsets": {
				"from": 322480,
				"to": 324440
			},
			"text": "抛出了那个著名的肌肤"
		},
		{
			"timestamps": {
				"from": "00:05:24,440",
				"to": "00:05:27,320"
			},
			"offsets": {
				"from": 324440,
				"to": 327320
			},
			"text": "请问你是从祖父还是祖母那边"
		},
		{
			"timestamps": {
				"from": "00:05:27,320",
				"to": "00:05:29,760"
			},
			"offsets": {
				"from": 327320,
				"to": 329760
			},
			"text": "继承了猴子的血头"
		},
		{
			"timestamps": {
				"from": "00:05:29,760",
				"to": "00:05:31,920"
			},
			"offsets": {
				"from": 329760,
				"to": 331920
			},
			"text": "欧文以为胜券在握"
		},
		{
			"timestamps": {
				"from": "00:05:31,920",
				"to": "00:05:34,360"
			},
			"offsets": {
				"from": 331920,
				"to": 334360
			},
			"text": "但他低估了替达尔文出战的斗拳"
		},
		{
			"timestamps": {
				"from": "00:05:34,360",
				"to": "00:05:35,520"
			},
			"offsets": {
				"from": 334360,
				"to": 335520
			},
			"text": "贺须礼"
		},
		{
			"timestamps": {
				"from": "00:05:35,520",
				"to": "00:05:37,000"
			},
			"offsets": {
				"from": 335520,
				"to": 337000
			},
			"text": "迎着全场的轰哮"
		},
		{
			"timestamps": {
				"from": "00:05:37,000",
				"to": "00:05:38,440"
			},
			"offsets": {
				"from": 337000,
				"to": 338440
			},
			"text": "贺须礼毫不退让"
		},
		{
			"timestamps": {
				"from": "00:05:38,440",
				"to": "00:05:39,600"
			},
			"offsets": {
				"from": 338440,
				"to": 339600
			},
			"text": "冷傲反击"
		},
		{
			"timestamps": {
				"from": "00:05:39,600",
				"to": "00:05:41,800"
			},
			"offsets": {
				"from": 339600,
				"to": 341800
			},
			"text": "我宁愿要一只猿猴做祖父"
		},
		{
			"timestamps": {
				"from": "00:05:41,800",
				"to": "00:05:44,120"
			},
			"offsets": {
				"from": 341800,
				"to": 344120
			},
			"text": "也不愿与用天赋遮蔽真理的人"
		},
		{
			"timestamps": {
				"from": "00:05:44,120",
				"to": "00:05:46,160"
			},
			"offsets": {
				"from": 344120,
				"to": 346160
			},
			"text": "产生任何关联"
		},
		{
			"timestamps": {
				"from": "00:05:46,160",
				"to": "00:05:47,520"
			},
			"offsets": {
				"from": 346160,
				"to": 347520
			},
			"text": "借刀杀人不成"
		},
		{
			"timestamps": {
				"from": "00:05:47,520",
				"to": "00:05:49,200"
			},
			"offsets": {
				"from": 347520,
				"to": 349200
			},
			"text": "欧文咬牙切齿"
		},
		{
			"timestamps": {
				"from": "00:05:49,200",
				"to": "00:05:50,040"
			},
			"offsets": {
				"from": 349200,
				"to": 350040
			},
			"text": "两年后"
		},
		{
			"timestamps": {
				"from": "00:05:50,040",
				"to": "00:05:51,520"
			},
			"offsets": {
				"from": 350040,
				"to": 351520
			},
			"text": "他终于撕下面具"
		},
		{
			"timestamps": {
				"from": "00:05:51,520",
				"to": "00:05:54,360"
			},
			"offsets": {
				"from": 351520,
				"to": 354360
			},
			"text": "带着他自认为能一击毙命的终极武器"
		},
		{
			"timestamps": {
				"from": "00:05:54,360",
				"to": "00:05:56,200"
			},
			"offsets": {
				"from": 354360,
				"to": 356200
			},
			"text": "亲自杀伤泪台"
		},
		{
			"timestamps": {
				"from": "00:05:56,200",
				"to": "00:05:57,840"
			},
			"offsets": {
				"from": 356200,
				"to": 357840
			},
			"text": "他宣称人类大脑里"
		},
		{
			"timestamps": {
				"from": "00:05:57,840",
				"to": "00:06:00,120"
			},
			"offsets": {
				"from": 357840,
				"to": 360120
			},
			"text": "有一种原类绝对没有的结构"
		},
		{
			"timestamps": {
				"from": "00:06:00,120",
				"to": "00:06:01,520"
			},
			"offsets": {
				"from": 360120,
				"to": 361520
			},
			"text": "叫小海马"
		},
		{
			"timestamps": {
				"from": "00:06:01,520",
				"to": "00:06:02,600"
			},
			"offsets": {
				"from": 361520,
				"to": 362600
			},
			"text": "他要死守人类"
		},
		{
			"timestamps": {
				"from": "00:06:02,600",
				"to": "00:06:05,520"
			},
			"offsets": {
				"from": 362600,
				"to": 365520
			},
			"text": "是上帝单独创造的底线"
		},
		{
			"timestamps": {
				"from": "00:06:05,520",
				"to": "00:06:06,320"
			},
			"offsets": {
				"from": 365520,
				"to": 366320
			},
			"text": "这一次"
		},
		{
			"timestamps": {
				"from": "00:06:06,320",
				"to": "00:06:07,840"
			},
			"offsets": {
				"from": 366320,
				"to": 367840
			},
			"text": "贺须礼直接把刀"
		},
		{
			"timestamps": {
				"from": "00:06:07,840",
				"to": "00:06:09,240"
			},
			"offsets": {
				"from": 367840,
				"to": 369240
			},
			"text": "递到了他脖子上"
		},
		{
			"timestamps": {
				"from": "00:06:09,240",
				"to": "00:06:11,080"
			},
			"offsets": {
				"from": 369240,
				"to": 371080
			},
			"text": "他当众切开了一只猴脑"
		},
		{
			"timestamps": {
				"from": "00:06:11,080",
				"to": "00:06:12,040"
			},
			"offsets": {
				"from": 371080,
				"to": 372040
			},
			"text": "头骨掀开"
		},
		{
			"timestamps": {
				"from": "00:06:12,040",
				"to": "00:06:14,640"
			},
			"offsets": {
				"from": 372040,
				"to": 374640
			},
			"text": "小海马就在那里"
		},
		{
			"timestamps": {
				"from": "00:06:14,640",
				"to": "00:06:15,960"
			},
			"offsets": {
				"from": 374640,
				"to": 375960
			},
			"text": "尸体不会说谎"
		},
		{
			"timestamps": {
				"from": "00:06:15,960",
				"to": "00:06:17,280"
			},
			"offsets": {
				"from": 375960,
				"to": 377280
			},
			"text": "58岁的欧文"
		},
		{
			"timestamps": {
				"from": "00:06:17,280",
				"to": "00:06:20,200"
			},
			"offsets": {
				"from": 377280,
				"to": 380200
			},
			"text": "学术信誉被一刀切碎"
		},
		{
			"timestamps": {
				"from": "00:06:20,200",
				"to": "00:06:21,960"
			},
			"offsets": {
				"from": 380200,
				"to": 381960
			},
			"text": "但真正给欧文的谎言"
		},
		{
			"timestamps": {
				"from": "00:06:21,960",
				"to": "00:06:23,760"
			},
			"offsets": {
				"from": 381960,
				"to": 383760
			},
			"text": "钉上最后一颗钉子的"
		},
		{
			"timestamps": {
				"from": "00:06:23,760",
				"to": "00:06:25,760"
			},
			"offsets": {
				"from": 383760,
				"to": 385760
			},
			"text": "是弟弟的石头"
		},
		{
			"timestamps": {
				"from": "00:06:25,760",
				"to": "00:06:26,880"
			},
			"offsets": {
				"from": 385760,
				"to": 386880
			},
			"text": "1878年"
		},
		{
			"timestamps": {
				"from": "00:06:26,880",
				"to": "00:06:29,800"
			},
			"offsets": {
				"from": 386880,
				"to": 389800
			},
			"text": "比利时矿工在地下322米处"
		},
		{
			"timestamps": {
				"from": "00:06:29,800",
				"to": "00:06:31,240"
			},
			"offsets": {
				"from": 389800,
				"to": 391240
			},
			"text": "挖出了30多具"
		},
		{
			"timestamps": {
				"from": "00:06:31,240",
				"to": "00:06:33,240"
			},
			"offsets": {
				"from": 391240,
				"to": 393240
			},
			"text": "完整的秦龙骨架"
		},
		{
			"timestamps": {
				"from": "00:06:33,240",
				"to": "00:06:34,160"
			},
			"offsets": {
				"from": 393240,
				"to": 394160
			},
			"text": "骨骼拼接"
		},
		{
			"timestamps": {
				"from": "00:06:34,160",
				"to": "00:06:37,800"
			},
			"offsets": {
				"from": 394160,
				"to": 397800
			},
			"text": "无情地击碎了欧文的四足犀牛模型"
		},
		{
			"timestamps": {
				"from": "00:06:37,800",
				"to": "00:06:39,640"
			},
			"offsets": {
				"from": 397800,
				"to": 399640
			},
			"text": "他们随时可以直立起身"
		},
		{
			"timestamps": {
				"from": "00:06:39,640",
				"to": "00:06:42,160"
			},
			"offsets": {
				"from": 399640,
				"to": 402160
			},
			"text": "真相昭然若揭"
		},
		{
			"timestamps": {
				"from": "00:06:42,160",
				"to": "00:06:44,560"
			},
			"offsets": {
				"from": 402160,
				"to": 404560
			},
			"text": "此时欧文依然活着"
		},
		{
			"timestamps": {
				"from": "00:06:44,560",
				"to": "00:06:47,640"
			},
			"offsets": {
				"from": 404560,
				"to": 407640
			},
			"text": "他亲眼看着自己一辈子的谎言被推翻"
		},
		{
			"timestamps": {
				"from": "00:06:47,640",
				"to": "00:06:49,840"
			},
			"offsets": {
				"from": 407640,
				"to": 409840
			},
			"text": "直到88岁死在豪宅里"
		},
		{
			"timestamps": {
				"from": "00:06:49,840",
				"to": "00:06:51,160"
			},
			"offsets": {
				"from": 409840,
				"to": 411160
			},
			"text": "也从未认错"
		},
		{
			"timestamps": {
				"from": "00:06:51,160",
				"to": "00:06:53,200"
			},
			"offsets": {
				"from": 411160,
				"to": 413200
			},
			"text": "大尔文曾写过一句评判"
		},
		{
			"timestamps": {
				"from": "00:06:53,200",
				"to": "00:06:54,680"
			},
			"offsets": {
				"from": 413200,
				"to": 414680
			},
			"text": "考虑到欧文的地位"
		},
		{
			"timestamps": {
				"from": "00:06:54,680",
				"to": "00:06:55,800"
			},
			"offsets": {
				"from": 414680,
				"to": 415800
			},
			"text": "没有任何事实"
		},
		{
			"timestamps": {
				"from": "00:06:55,800",
				"to": "00:06:58,160"
			},
			"offsets": {
				"from": 415800,
				"to": 418160
			},
			"text": "比他一辈子没有培养出一个学生"
		},
		{
			"timestamps": {
				"from": "00:06:58,160",
				"to": "00:06:59,960"
			},
			"offsets": {
				"from": 418160,
				"to": 419960
			},
			"text": "更能说明他的为人"
		},
		{
			"timestamps": {
				"from": "00:06:59,960",
				"to": "00:07:01,960"
			},
			"offsets": {
				"from": 419960,
				"to": 421960
			},
			"text": "他到处抢夺冠名权"
		},
		{
			"timestamps": {
				"from": "00:07:01,960",
				"to": "00:07:04,280"
			},
			"offsets": {
				"from": 421960,
				"to": 424280
			},
			"text": "却从未开启一条道路"
		},
		{
			"timestamps": {
				"from": "00:07:04,280",
				"to": "00:07:05,040"
			},
			"offsets": {
				"from": 424280,
				"to": 425040
			},
			"text": "今天"
		},
		{
			"timestamps": {
				"from": "00:07:05,040",
				"to": "00:07:06,880"
