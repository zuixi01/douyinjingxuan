				"to": 117720
			},
			"text": "他的论文确实不严谨"
		},
		{
			"timestamps": {
				"from": "00:01:57,720",
				"to": "00:02:00,040"
			},
			"offsets": {
				"from": 117720,
				"to": 120040
			},
			"text": "但是他确实受到了学校的表扬"
		},
		{
			"timestamps": {
				"from": "00:02:00,040",
				"to": "00:02:01,320"
			},
			"offsets": {
				"from": 120040,
				"to": 121320
			},
			"text": "奖学金拿到手软"
		},
		{
			"timestamps": {
				"from": "00:02:01,320",
				"to": "00:02:04,160"
			},
			"offsets": {
				"from": 121320,
				"to": 124160
			},
			"text": "那么他的同班同学就会面临一个选择"
		},
		{
			"timestamps": {
				"from": "00:02:04,160",
				"to": "00:02:05,600"
			},
			"offsets": {
				"from": 124160,
				"to": 125600
			},
			"text": "要么玩命举报的"
		},
		{
			"timestamps": {
				"from": "00:02:05,600",
				"to": "00:02:07,800"
			},
			"offsets": {
				"from": 125600,
				"to": 127800
			},
			"text": "要么比他更玩命的水论文"
		},
		{
			"timestamps": {
				"from": "00:02:07,800",
				"to": "00:02:11,120"
			},
			"offsets": {
				"from": 127800,
				"to": 131120
			},
			"text": "反而安心做科研这个最好的选项反而没有了"
		},
		{
			"timestamps": {
				"from": "00:02:11,120",
				"to": "00:02:13,480"
			},
			"offsets": {
				"from": 131120,
				"to": 133480
			},
			"text": "这就是科研领域的劣币驱逐良辟"
		},
		{
			"timestamps": {
				"from": "00:02:13,480",
				"to": "00:02:14,160"
			},
			"offsets": {
				"from": 133480,
				"to": 134160
			},
			"text": "再别可讲啊"
		},
		{
			"timestamps": {
				"from": "00:02:14,160",
				"to": "00:02:15,320"
			},
			"offsets": {
				"from": 134160,
				"to": 135320
			},
			"text": "世界各地都有这个问题"
		},
		{
			"timestamps": {
				"from": "00:02:15,320",
				"to": "00:02:16,240"
			},
			"offsets": {
				"from": 135320,
				"to": 136240
			},
			"text": "不止我国啊"
		},
		{
			"timestamps": {
				"from": "00:02:16,240",
				"to": "00:02:18,360"
			},
			"offsets": {
				"from": 136240,
				"to": 138360
			},
			"text": "越好的学校这种情况越轻"
		},
		{
			"timestamps": {
				"from": "00:02:18,360",
				"to": "00:02:20,560"
			},
			"offsets": {
				"from": 138360,
				"to": 140560
			},
			"text": "那我国论文造假多的第二个原因"
		},
		{
			"timestamps": {
				"from": "00:02:20,560",
				"to": "00:02:21,720"
			},
			"offsets": {
				"from": 140560,
				"to": 141720
			},
			"text": "临床医生"
		},
		{
			"timestamps": {
				"from": "00:02:21,720",
				"to": "00:02:24,200"
			},
			"offsets": {
				"from": 141720,
				"to": 144200
			},
			"text": "我国的临床医生会被迫发表论文"
		},
		{
			"timestamps": {
				"from": "00:02:24,200",
				"to": "00:02:25,160"
			},
			"offsets": {
				"from": 144200,
				"to": 145160
			},
			"text": "但是在很多国家"
		},
		{
			"timestamps": {
				"from": "00:02:25,160",
				"to": "00:02:27,640"
			},
			"offsets": {
				"from": 145160,
				"to": 147640
			},
			"text": "包括美国他们的医生没有发论文的压力"
		},
		{
			"timestamps": {
				"from": "00:02:27,640",
				"to": "00:02:30,840"
			},
			"offsets": {
				"from": 147640,
				"to": 150840
			},
			"text": "医生只需要做好治病救人这个本职工作就可以了"
		},
		{
			"timestamps": {
				"from": "00:02:30,840",
				"to": "00:02:31,680"
			},
			"offsets": {
				"from": 150840,
				"to": 151680
			},
			"text": "再提一个讲"
		},
		{
			"timestamps": {
				"from": "00:02:31,680",
				"to": "00:02:35,320"
			},
			"offsets": {
				"from": 151680,
				"to": 155320
			},
			"text": "我也无意去比较世界各国的医疗体制的好坏啊"
		},
		{
			"timestamps": {
				"from": "00:02:35,320",
				"to": "00:02:37,440"
			},
			"offsets": {
				"from": 155320,
				"to": 157440
			},
			"text": "我只想讨论医生发论文这个问题"
		},
		{
			"timestamps": {
				"from": "00:02:37,440",
				"to": "00:02:39,800"
			},
			"offsets": {
				"from": 157440,
				"to": 159800
			},
			"text": "东北某一个985的附属第三医院"
		},
		{
			"timestamps": {
				"from": "00:02:39,800",
				"to": "00:02:40,880"
			},
			"offsets": {
				"from": 159800,
				"to": 160880
			},
			"text": "是学生造假大谷"
		},
		{
			"timestamps": {
				"from": "00:02:40,880",
				"to": "00:02:44,200"
			},
			"offsets": {
				"from": 160880,
				"to": 164200
			},
			"text": "经常被曝光他们那儿有医生从论文工厂买论文"
		},
		{
			"timestamps": {
				"from": "00:02:44,200",
				"to": "00:02:46,280"
			},
			"offsets": {
				"from": 164200,
				"to": 166280
			},
			"text": "但是我的家人体解或者身体不舒服"
		},
		{
			"timestamps": {
				"from": "00:02:46,280",
				"to": "00:02:47,400"
			},
			"offsets": {
				"from": 166280,
				"to": 167400
			},
			"text": "都会去这家医院"
		},
		{
			"timestamps": {
				"from": "00:02:47,400",
				"to": "00:02:49,000"
			},
			"offsets": {
				"from": 167400,
				"to": 169000
			},
			"text": "这里的医生我也认识几个"
		},
		{
			"timestamps": {
				"from": "00:02:49,000",
				"to": "00:02:49,840"
			},
			"offsets": {
				"from": 169000,
				"to": 169840
			},
			"text": "医术没问题"
		},
		{
			"timestamps": {
				"from": "00:02:49,840",
				"to": "00:02:51,040"
			},
			"offsets": {
				"from": 169840,
				"to": 171040
			},
			"text": "甚至说非常的好"
		},
		{
			"timestamps": {
				"from": "00:02:51,040",
				"to": "00:02:52,720"
			},
			"offsets": {
				"from": 171040,
				"to": 172720
			},
			"text": "那科研水平那是真的了"
		},
		{
			"timestamps": {
				"from": "00:02:52,720",
				"to": "00:02:54,360"
			},
			"offsets": {
				"from": 172720,
				"to": 174360
			},
			"text": "因为他们就没学过怎么发论文"
		},
		{
			"timestamps": {
				"from": "00:02:54,360",
				"to": "00:02:56,240"
			},
			"offsets": {
				"from": 174360,
				"to": 176240
			},
			"text": "他们只学了怎么给人看病"
		},
		{
			"timestamps": {
				"from": "00:02:56,240",
				"to": "00:02:57,440"
			},
			"offsets": {
				"from": 176240,
				"to": 177440
			},
			"text": "这还是三甲医院"
		},
		{
			"timestamps": {
				"from": "00:02:57,440",
				"to": "00:02:59,920"
			},
			"offsets": {
				"from": 177440,
				"to": 179920
			},
			"text": "还有一些县级医院平时常也要发论文"
		},
		{
			"timestamps": {
				"from": "00:02:59,920",
				"to": "00:03:02,960"
			},
			"offsets": {
				"from": 179920,
				"to": 182960
			},
			"text": "这些县级医院的医生发论文要跨过三座大山"
		},
		{
			"timestamps": {
				"from": "00:03:02,960",
				"to": "00:03:04,640"
			},
			"offsets": {
				"from": 182960,
				"to": 184640
			},
			"text": "第一 医生本人不会科研"
		},
		{
			"timestamps": {
				"from": "00:03:04,640",
				"to": "00:03:06,360"
			},
			"offsets": {
				"from": 184640,
				"to": 186360
			},
			"text": "第二 即使他会科研"
		},
		{
			"timestamps": {
				"from": "00:03:06,360",
				"to": "00:03:08,280"
			},
			"offsets": {
				"from": 186360,
				"to": 188280
			},
			"text": "县医院也没有实验室"
		},
		{
			"timestamps": {
				"from": "00:03:08,280",
				"to": "00:03:10,480"
			},
			"offsets": {
				"from": 188280,
				"to": 190480
			},
			"text": "第三 即使医院有实验室"
		},
		{
			"timestamps": {
				"from": "00:03:10,480",
				"to": "00:03:12,200"
			},
			"offsets": {
				"from": 190480,
				"to": 192200
			},
			"text": "他手里也没有经费"
		},
		{
			"timestamps": {
				"from": "00:03:12,200",
				"to": "00:03:14,280"
			},
			"offsets": {
				"from": 192200,
				"to": 194280
			},
			"text": "如此三座大山摆在医生面前"
		},
		{
			"timestamps": {
				"from": "00:03:14,280",
				"to": "00:03:15,560"
			},
			"offsets": {
				"from": 194280,
				"to": 195560
			},
			"text": "请问他该怎么办"
		},
		{
			"timestamps": {
				"from": "00:03:15,560",
				"to": "00:03:18,000"
			},
			"offsets": {
				"from": 195560,
				"to": 198000
			},
			"text": "要么放弃职商 一辈子做底层"
		},
		{
			"timestamps": {
				"from": "00:03:18,000",
				"to": "00:03:19,400"
			},
			"offsets": {
				"from": 198000,
				"to": 199400
			},
			"text": "要么就买论文呗"
		},
		{
			"timestamps": {
				"from": "00:03:19,400",
				"to": "00:03:20,760"
			},
			"offsets": {
				"from": 199400,
				"to": 200760
			},
			"text": "外行人可能第一次听说"
		},
		{
			"timestamps": {
				"from": "00:03:20,760",
				"to": "00:03:22,120"
			},
			"offsets": {
				"from": 200760,
				"to": 202120
			},
			"text": "原来这里面这么机箱"
		},
		{
			"timestamps": {
				"from": "00:03:22,120",
				"to": "00:03:23,440"
			},
			"offsets": {
				"from": 202120,
				"to": 203440
			},
			"text": "所以医生朋友们留个言"
		},
		{
			"timestamps": {
				"from": "00:03:23,440",
				"to": "00:03:24,800"
			},
			"offsets": {
				"from": 203440,
				"to": 204800
			},
			"text": "证明我说的是真的"
		},
		{
			"timestamps": {
				"from": "00:03:24,800",
				"to": "00:03:26,800"
			},
			"offsets": {
				"from": 204800,
				"to": 206800
			},
			"text": "我也求证了美国那边的留学生朋友"
		},
		{
			"timestamps": {
				"from": "00:03:26,800",
				"to": "00:03:29,960"
			},
			"offsets": {
				"from": 206800,
				"to": 209960
			},
			"text": "那边的医生一般是没有被迫发表论文的压力的"
		},
		{
			"timestamps": {
				"from": "00:03:29,960",
				"to": "00:03:30,880"
			},
			"offsets": {
				"from": 209960,
				"to": 210880
			},
			"text": "这是官方统计的"
		},
		{
			"timestamps": {
				"from": "00:03:30,880",
				"to": "00:03:32,640"
			},
			"offsets": {
				"from": 210880,
				"to": 212640
			},
			"text": "哪些医院造假数量最多"
		},
		{
			"timestamps": {
				"from": "00:03:32,640",
				"to": "00:03:34,440"
			},
			"offsets": {
				"from": 212640,
				"to": 214440
			},
			"text": "你看 有多少个是中国的"
		},
		{
			"timestamps": {
				"from": "00:03:34,440",
				"to": "00:03:36,920"
			},
			"offsets": {
				"from": 214440,
				"to": 216920
			},
			"text": "所以我国的临床医生贡献了大量的假论文"
		},
		{
			"timestamps": {
				"from": "00:03:36,920",
				"to": "00:03:38,320"
			},
			"offsets": {
				"from": 216920,
				"to": 218320
			},
			"text": "这跟学术道德没什么关系"
		},
		{
			"timestamps": {
				"from": "00:03:38,320",
				"to": "00:03:39,320"
			},
			"offsets": {
				"from": 218320,
				"to": 219320
			},
			"text": "全是生存压力"
		},
		{
			"timestamps": {
				"from": "00:03:39,320",
				"to": "00:03:42,560"
			},
			"offsets": {
				"from": 219320,
				"to": 222560
			},
			"text": "我国论文造假多的第三个原因 缺少学术侦探"
		},
		{
			"timestamps": {
				"from": "00:03:42,560",
				"to": "00:03:43,520"
			},
			"offsets": {
				"from": 222560,
				"to": 223520
			},
			"text": "学术侦探是啥"
		},
		{
			"timestamps": {
				"from": "00:03:43,520",
				"to": "00:03:44,920"
			},
			"offsets": {
				"from": 223520,
				"to": 224920
			},
			"text": "举个例子 西奥利托大卫"
		},
		{
			"timestamps": {
				"from": "00:03:44,920",
				"to": "00:03:46,040"
			},
			"offsets": {
				"from": 224920,
				"to": 226040
			},
			"text": "百度一下你就知道"
		},
		{
			"timestamps": {
				"from": "00:03:46,040",
				"to": "00:03:47,680"
			},
			"offsets": {
				"from": 226040,
				"to": 227680
			},
			"text": "我们俩经常用邮件去交流"
		},
		{
			"timestamps": {
				"from": "00:03:47,680",
				"to": "00:03:49,000"
			},
			"offsets": {
				"from": 227680,
				"to": 229000
			},
			"text": "学术侦探的圈子也不大"
		},
		{
			"timestamps": {
				"from": "00:03:49,000",
				"to": "00:03:50,080"
			},
			"offsets": {
				"from": 229000,
				"to": 230080
			},
			"text": "互相认识也很正常"
		},
		{
			"timestamps": {
				"from": "00:03:50,080",
				"to": "00:03:52,240"
			},
			"offsets": {
				"from": 230080,
				"to": 232240
			},
			"text": "2024年大卫以数据侦探的身份"
		},
		{
			"timestamps": {
				"from": "00:03:52,240",
				"to": "00:03:54,920"
			},
			"offsets": {
				"from": 232240,
				"to": 234920
			},
			"text": "发文指控哈佛大学医学院附属的一个研究所"
		},
		{
			"timestamps": {
				"from": "00:03:54,920",
				"to": "00:03:56,240"
			},
			"offsets": {
				"from": 234920,
				"to": 236240
			},
			"text": "存在数据杂假问题"
		},
		{
			"timestamps": {
				"from": "00:03:56,240",
				"to": "00:03:57,720"
			},
			"offsets": {
				"from": 236240,
				"to": 237720
			},
			"text": "2025年12月16日"
		},
		{
			"timestamps": {
				"from": "00:03:57,720",
				"to": "00:03:58,800"
			},
			"offsets": {
				"from": 237720,
				"to": 238800
			},
			"text": "美国司法部宣布"
		},
		{
			"timestamps": {
				"from": "00:03:58,800",
				"to": "00:04:02,120"
			},
			"offsets": {
				"from": 238800,
				"to": 242120
			},
			"text": "这个研究所同意支付1500万美元"
		},
		{
			"timestamps": {
				"from": "00:04:02,120",
				"to": "00:04:03,560"
			},
			"offsets": {
				"from": 242120,
				"to": 243560
			},
			"text": "以达成促送和解"
		},
		{
			"timestamps": {
				"from": "00:04:03,560",
				"to": "00:04:07,280"
			},
			"offsets": {
				"from": 243560,
				"to": 247280
			},
			"text": "西奥利托大卫分到了赔偿金的263万美元"
		},
		{
			"timestamps": {
				"from": "00:04:07,280",
				"to": "00:04:10,040"
			},
			"offsets": {
				"from": 247280,
				"to": 250040
			},
			"text": "最后 政府提供经费就好比是假方"
		},
		{
			"timestamps": {
				"from": "00:04:10,040",
				"to": "00:04:12,040"
			},
			"offsets": {
				"from": 250040,
				"to": 252040
			},
			"text": "哈佛大学医学院拿钱去做研究"
		},
		{
			"timestamps": {
				"from": "00:04:12,040",
				"to": "00:04:13,160"
			},
			"offsets": {
				"from": 252040,
				"to": 253160
			},
			"text": "就好比是乙方"
		},
		{
			"timestamps": {
				"from": "00:04:13,160",
				"to": "00:04:15,080"
			},
			"offsets": {
				"from": 253160,
				"to": 255080
			},
			"text": "现在乙方在糊弄假方"
		},
		{
			"timestamps": {
				"from": "00:04:15,080",
				"to": "00:04:16,000"
			},
			"offsets": {
				"from": 255080,
				"to": 256000
			},
			"text": "但是假方不知道"
		},
		{
			"timestamps": {
				"from": "00:04:16,000",
				"to": "00:04:17,440"
			},
			"offsets": {
				"from": 256000,
				"to": 257440
			},
			"text": "于是就出来一个学术侦探"
		},
		{
			"timestamps": {
				"from": "00:04:17,440",
				"to": "00:04:19,240"
			},
			"offsets": {
				"from": 257440,
				"to": 259240
			},
			"text": "告诉假方 乙方在糊弄你"
		},
		{
			"timestamps": {
				"from": "00:04:19,240",
				"to": "00:04:22,160"
			},
			"offsets": {
				"from": 259240,
				"to": 262160
			},
			"text": "那么这个学术侦探就帮助假方挽回了损失"
		},
		{
			"timestamps": {
				"from": "00:04:22,160",
				"to": "00:04:25,200"
			},
			"offsets": {
				"from": 262160,
				"to": 265200
			},
			"text": "所以 他是不是理应收到一些报酬"
		},
		{
			"timestamps": {
				"from": "00:04:25,200",
				"to": "00:04:26,760"
			},
			"offsets": {
				"from": 265200,
				"to": 266760
			},
			"text": "我曾经也想当个学术侦探"
		},
		{
			"timestamps": {
				"from": "00:04:26,760",
				"to": "00:04:27,960"
			},
			"offsets": {
				"from": 266760,
				"to": 267960
			},
			"text": "我也成功举报了一些人"
		},
		{
			"timestamps": {
				"from": "00:04:27,960",
				"to": "00:04:29,000"
			},
			"offsets": {
				"from": 267960,
				"to": 269000
			},
			"text": "去年夏天我举报了"
		},
		{
			"timestamps": {
				"from": "00:04:29,000",
				"to": "00:04:31,000"
			},
			"offsets": {
				"from": 269000,
				"to": 271000
			},
			"text": "南京某三甲医院的副院长学术造假"
		},
		{
			"timestamps": {
				"from": "00:04:31,000",
				"to": "00:04:33,400"
			},
			"offsets": {
				"from": 271000,
				"to": 273400
			},
			"text": "我当时还发视频了 很多人都知道两个月前"
		},
		{
			"timestamps": {
				"from": "00:04:33,400",
				"to": "00:04:34,480"
			},
			"offsets": {
				"from": 273400,
				"to": 274480
			},
			"text": "基金委给我打电话"
		},
		{
			"timestamps": {
				"from": "00:04:34,480",
				"to": "00:04:36,720"
			},
			"offsets": {
				"from": 274480,
				"to": 276720
			},
			"text": "说那个副院长被停了两年的经费"
		},
		{
			"timestamps": {
				"from": "00:04:36,720",
				"to": "00:04:38,800"
			},
			"offsets": {
				"from": 276720,
				"to": 278800
			},
			"text": "但是你这边最好保密 以防被报复"
		},
		{
			"timestamps": {
				"from": "00:04:38,800",
				"to": "00:04:40,280"
			},
			"offsets": {
				"from": 278800,
				"to": 280280
			},
			"text": "他可能不知道我发视频了"
		},
		{
			"timestamps": {
				"from": "00:04:40,280",
				"to": "00:04:41,400"
			},
			"offsets": {
				"from": 280280,
				"to": 281400
			},
			"text": "没什么保密的必要了"
		},
		{
			"timestamps": {
				"from": "00:04:41,400",
				"to": "00:04:43,480"
			},
			"offsets": {
				"from": 281400,
				"to": 283480
			},
			"text": "那是我举报的其他人最好还是保密"
		},
		{
			"timestamps": {
				"from": "00:04:43,480",
				"to": "00:04:45,880"
			},
			"offsets": {
				"from": 283480,
				"to": 285880
			},
			"text": "关键是基金委一分钱都没给我"
		},
		{
			"timestamps": {
				"from": "00:04:45,880",
				"to": "00:04:47,640"
			},
			"offsets": {
				"from": 285880,
				"to": 287640
			},
			"text": "好在有个口头感激"
		},
		{
			"timestamps": {
				"from": "00:04:47,640",
				"to": "00:04:49,440"
			},
			"offsets": {
				"from": 287640,
				"to": 289440
			},
			"text": "一分钱挣不着 我还到处得罪人"
		},
		{
			"timestamps": {
				"from": "00:04:49,440",
				"to": "00:04:50,320"
			},
			"offsets": {
				"from": 289440,
				"to": 290320
			},
			"text": "你说这活咋干"
		},
		{
			"timestamps": {
				"from": "00:04:50,320",
				"to": "00:04:51,320"
			},
			"offsets": {
				"from": 290320,
				"to": 291320
			},
			"text": "我现在也是躺平了"
		},
		{
			"timestamps": {
				"from": "00:04:51,320",
				"to": "00:04:53,080"
			},
			"offsets": {
				"from": 291320,
				"to": 293080
			},
			"text": "但是我做视频本来也要看论文"
		},
		{
			"timestamps": {
				"from": "00:04:53,080",
				"to": "00:04:55,640"
			},
			"offsets": {
				"from": 293080,
				"to": 295640
			},
			"text": "我现在看论文比我读书的时候看的还多"
		},
		{
			"timestamps": {
				"from": "00:04:55,640",
				"to": "00:04:58,440"
			},
			"offsets": {
				"from": 295640,
				"to": 298440
			},
			"text": "看到问题论文我就顺手发个邮件举报一下"
		},
		{
			"timestamps": {
				"from": "00:04:58,440",
				"to": "00:05:01,320"
			},
			"offsets": {
				"from": 298440,
				"to": 301320
			},
			"text": "但是你让我别的活不干 故意去找论文的毛病"
		},
		{
			"timestamps": {
				"from": "00:05:01,320",
				"to": "00:05:02,520"
			},
			"offsets": {
				"from": 301320,
				"to": 302520
			},
			"text": "这个没有动力了"
		},
		{
			"timestamps": {
				"from": "00:05:02,520",
				"to": "00:05:03,880"
			},
			"offsets": {
				"from": 302520,
				"to": 303880
			},
			"text": "所以我们现在这边的情况是"
		},
		{
			"timestamps": {
				"from": "00:05:03,880",
				"to": "00:05:06,320"
			},
			"offsets": {
				"from": 303880,
				"to": 306320
			},
			"text": "问题论文缺少天敌 缺少克星"
		},
		{
			"timestamps": {
				"from": "00:05:06,320",
				"to": "00:05:07,440"
			},
			"offsets": {
				"from": 306320,
				"to": 307440
			},
			"text": "所以它比较猖獗"
		},
		{
			"timestamps": {
				"from": "00:05:07,440",
				"to": "00:05:09,560"
			},
			"offsets": {
				"from": 307440,
				"to": 309560
			},
			"text": "我国论文造假多的第四个原因"
		},
		{
			"timestamps": {
				"from": "00:05:09,560",
				"to": "00:05:11,880"
			},
			"offsets": {
				"from": 309560,
				"to": 311880
			},
			"text": "我国的论文总量已经是世界第一了"
		},
		{
			"timestamps": {
				"from": "00:05:11,880",
				"to": "00:05:13,440"
			},
			"offsets": {
				"from": 311880,
				"to": 313440
			},
			"text": "而且增速极快"
		},
		{
			"timestamps": {
				"from": "00:05:13,440",
				"to": "00:05:15,560"
			},
			"offsets": {
				"from": 313440,
				"to": 315560
			},
			"text": "这必然会产生一定的泡沫"
		},
		{
			"timestamps": {
				"from": "00:05:15,560",
				"to": "00:05:17,400"
			},
			"offsets": {
				"from": 315560,
				"to": 317400
			},
			"text": "这些假论文就是那个泡沫"
		},
		{
			"timestamps": {
				"from": "00:05:17,400",
				"to": "00:05:18,840"
			},
			"offsets": {
				"from": 317400,
				"to": 318840
			},
			"text": "中南大学学术期刊房显示"
		},
		{
			"timestamps": {
				"from": "00:05:18,840",
				"to": "00:05:21,120"
			},
			"offsets": {
				"from": 318840,
				"to": 321120
			},
			"text": "2024年我国高指平国际期刊论文数量"
		},
		{
			"timestamps": {
				"from": "00:05:21,120",
				"to": "00:05:23,880"
			},
			"offsets": {
				"from": 321120,
				"to": 323880
			},
			"text": "以及背景次数继续保持世界第一"
		},
		{
			"timestamps": {
				"from": "00:05:23,880",
				"to": "00:05:24,680"
			},
			"offsets": {
				"from": 323880,
				"to": 324680
			},
			"text": "根据那些数据"
		},
		{
			"timestamps": {
				"from": "00:05:24,680",
				"to": "00:05:26,120"
			},
			"offsets": {
				"from": 324680,
				"to": 326120
			},
			"text": "中国的论文数量反超美国"
		},
		{
			"timestamps": {
				"from": "00:05:26,120",
				"to": "00:05:28,440"
			},
			"offsets": {
				"from": 326120,
				"to": 328440
			},
			"text": "应该是在2021年到2022年之间"
		},
		{
			"timestamps": {
				"from": "00:05:28,440",
				"to": "00:05:30,640"
			},
			"offsets": {
				"from": 328440,
				"to": 330640
			},
			"text": "更夸张的是论文数量的增长速度"
		},
		{
			"timestamps": {
				"from": "00:05:30,640",
				"to": "00:05:31,520"
			},
			"offsets": {
				"from": 330640,
				"to": 331520
			},
			"text": "大家可以看到"
		},
		{
			"timestamps": {
				"from": "00:05:31,520",
				"to": "00:05:33,720"
			},
			"offsets": {
				"from": 331520,
				"to": 333720
			},
			"text": "只有中国在指数增长"
		},
		{
			"timestamps": {
				"from": "00:05:33,720",
				"to": "00:05:35,160"
			},
			"offsets": {
				"from": 333720,
				"to": 335160
			},
			"text": "如此剧烈的扩张"
		},
		{
			"timestamps": {
				"from": "00:05:35,160",
				"to": "00:05:37,000"
			},
			"offsets": {
				"from": 335160,
				"to": 337000
			},
			"text": "里边有泡沫是在所难免的"
		},
		{
			"timestamps": {
				"from": "00:05:37,000",
				"to": "00:05:38,320"
			},
			"offsets": {
				"from": 337000,
				"to": 338320
			},
			"text": "姚玉老师前段时间发文说"
		},
		{
			"timestamps": {
				"from": "00:05:38,320",
				"to": "00:05:41,320"
			},
			"offsets": {
				"from": 338320,
				"to": 341320
			},
			"text": "在2050年中国诺奖数量将反超日本"
		},
		{
			"timestamps": {
				"from": "00:05:41,320",
				"to": "00:05:42,560"
			},
			"offsets": {
				"from": 341320,
				"to": 342560
			},
			"text": "有不少网友不太认同"
		},
		{
			"timestamps": {
				"from": "00:05:42,560",
				"to": "00:05:45,000"
			},
			"offsets": {
				"from": 342560,
				"to": 345000
			},
			"text": "认为姚老师会成为下一个黄院士"
		},
		{
			"timestamps": {
				"from": "00:05:45,000",
				"to": "00:05:46,640"
			},
			"offsets": {
				"from": 345000,
				"to": 346640
			},
			"text": "黄院士在2013年预测"
		},
		{
			"timestamps": {
				"from": "00:05:46,640",
				"to": "00:05:49,560"
			},
			"offsets": {
				"from": 346640,
				"to": 349560
			},
			"text": "10年后中国人得诺奖等其他大奖"
		},
		{
			"timestamps": {
				"from": "00:05:49,560",
				"to": "00:05:50,520"
			},
			"offsets": {
				"from": 349560,
				"to": 350520
			},
			"text": "将成为常态"
		},
		{
			"timestamps": {
				"from": "00:05:50,520",
				"to": "00:05:51,640"
			},
			"offsets": {
				"from": 350520,
				"to": 351640
			},
			"text": "没有任何悬念"
		},
		{
			"timestamps": {
				"from": "00:05:51,640",
				"to": "00:05:53,960"
			},
			"offsets": {
				"from": 351640,
				"to": 353960
			},
			"text": "结果好像确实也没有什么悬念"
		},
		{
			"timestamps": {
				"from": "00:05:53,960",
				"to": "00:05:56,280"
			},
			"offsets": {
				"from": 353960,
				"to": 356280
			},
			"text": "可是我这次确实赞成姚老师的说法"
		},
		{
			"timestamps": {
				"from": "00:05:56,280",
				"to": "00:05:57,760"
			},
			"offsets": {
				"from": 356280,
				"to": 357760
			},
			"text": "大家看论文的增长速度"
		},
		{
			"timestamps": {
				"from": "00:05:57,760",
				"to": "00:06:00,160"
			},
			"offsets": {
				"from": 357760,
				"to": 360160
			},
			"text": "如果我国继续保持现在的势头"
		},
		{
			"timestamps": {
				"from": "00:06:00,160",
				"to": "00:06:01,480"
			},
			"offsets": {
				"from": 360160,
				"to": 361480
			},
			"text": "到2050年前后"
		},
		{
			"timestamps": {
				"from": "00:06:01,480",
				"to": "00:06:02,680"
			},
			"offsets": {
				"from": 361480,
				"to": 362680
			},
			"text": "中国的论文发表数量"
		},
		{
			"timestamps": {
				"from": "00:06:02,680",
				"to": "00:06:04,600"
			},
			"offsets": {
				"from": 362680,
				"to": 364600
			},
			"text": "可能是日本的100倍之多"
		},
		{
			"timestamps": {
				"from": "00:06:04,600",
				"to": "00:06:06,120"
			},
			"offsets": {
				"from": 364600,
				"to": 366120
			},
			"text": "我国的科研经费的投入"
		},
		{
			"timestamps": {
				"from": "00:06:06,120",
				"to": "00:06:07,560"
			},
			"offsets": {
				"from": 366120,
				"to": 367560
			},
			"text": "我国的科研人员的数量"
		},
		{
			"timestamps": {
				"from": "00:06:07,560",
				"to": "00:06:09,520"
			},
			"offsets": {
				"from": 367560,
				"to": 369520
			},
			"text": "都会是日本的非常多倍"
		},
		{
			"timestamps": {
				"from": "00:06:09,520",
				"to": "00:06:10,320"
			},
			"offsets": {
				"from": 369520,
				"to": 370320
			},
			"text": "这种情况下"
		},
		{
			"timestamps": {
				"from": "00:06:10,320",
				"to": "00:06:11,480"
			},
			"offsets": {
				"from": 370320,
				"to": 371480
			},
			"text": "赢是必然的"
		},
		{
			"timestamps": {
				"from": "00:06:11,480",
				"to": "00:06:12,840"
			},
			"offsets": {
				"from": 371480,
				"to": 372840
			},
			"text": "那输了才不正常的"
		},
		{
			"timestamps": {
				"from": "00:06:12,840",
				"to": "00:06:14,720"
			},
			"offsets": {
				"from": 372840,
				"to": 374720
			},
			"text": "暴打幼儿园小朋友这真不会输"
		},
		{
			"timestamps": {
				"from": "00:06:14,720",
				"to": "00:06:16,920"
			},
			"offsets": {
				"from": 374720,
				"to": 376920
			},
			"text": "从一个成果诞生到他得诺奖"
		},
		{
			"timestamps": {
				"from": "00:06:16,920",
				"to": "00:06:18,920"
			},
			"offsets": {
				"from": 376920,
				"to": 378920
			},
			"text": "大概需要10年到20年的时间"
		},
		{
			"timestamps": {
				"from": "00:06:18,920",
				"to": "00:06:20,680"
			},
			"offsets": {
				"from": 378920,
				"to": 380680
			},
			"text": "2050年那个诺奖的成果"
		},
		{
			"timestamps": {
				"from": "00:06:20,680",
				"to": "00:06:22,760"
			},
			"offsets": {
				"from": 380680,
				"to": 382760
			},
			"text": "应该是诞生在2030年左右"
		},
		{
			"timestamps": {
				"from": "00:06:22,760",
				"to": "00:06:24,560"
			},
			"offsets": {
				"from": 382760,
				"to": 384560
			},
			"text": "到2030年中国的科研体量"
		},
		{
			"timestamps": {
				"from": "00:06:24,560",
				"to": "00:06:26,680"
			},
			"offsets": {
				"from": 384560,
				"to": 386680
			},
			"text": "就会是日本的几倍甚至十几倍"
		},
		{
			"timestamps": {
				"from": "00:06:26,680",
				"to": "00:06:28,560"
			},
			"offsets": {
				"from": 386680,
				"to": 388560
			},
			"text": "所以诺奖超过日本是必然的"
		},
		{
			"timestamps": {
				"from": "00:06:28,560",
				"to": "00:06:29,720"
			},
			"offsets": {
				"from": 388560,
				"to": 389720
			},
			"text": "至于扰耳术的朋友们"
		},
		{
			"timestamps": {
				"from": "00:06:29,720",
				"to": "00:06:31,320"
			},
			"offsets": {
				"from": 389720,
				"to": 391320
			},
			"text": "您可能也是过于悲观了"
		},
		{
			"timestamps": {
				"from": "00:06:31,320",
				"to": "00:06:32,400"
			},
			"offsets": {
				"from": 391320,
				"to": 392400
			},
			"text": "这就是我想说的几点"
		},
		{
			"timestamps": {
				"from": "00:06:32,400",
				"to": "00:06:34,200"
			},
			"offsets": {
				"from": 392400,
				"to": 394200
			},
			"text": "我国学术论文造假多的原因"
		},
		{
			"timestamps": {
				"from": "00:06:34,200",
				"to": "00:06:36,040"
			},
			"offsets": {
				"from": 394200,
				"to": 396040
			},
			"text": "总结起来学术论文造假多"
		},
		{
			"timestamps": {
				"from": "00:06:36,040",
				"to": "00:06:37,800"
			},
			"offsets": {
				"from": 396040,
				"to": 397800
			},
			"text": "不是因为我国科研人员的"
		},
		{
			"timestamps": {
				"from": "00:06:37,800",
				"to": "00:06:39,000"
			},
			"offsets": {
				"from": 397800,
				"to": 399000
			},
			"text": "学术道德水平差"
		},
		{
			"timestamps": {
				"from": "00:06:39,000",
				"to": "00:06:41,920"
			},
			"offsets": {
				"from": 399000,
				"to": 401920
			},
			"text": "F统计量它代表的是一个"
		},
		{
			"timestamps": {
				"from": "00:06:41,920",
				"to": "00:06:47,760"
			},
			"offsets": {
				"from": 401920,
				"to": 407760
			},
			"text": "SNP对于整个MR分析的统计学强度"
		},
		{
			"timestamps": {
				"from": "00:06:47,760",
				"to": "00:06:49,920"
			},
			"offsets": {
				"from": 407760,
				"to": 409920
			},
			"text": "这个统计学强度如果小于10的话"
		},
		{
			"timestamps": {
				"from": "00:06:49,920",
				"to": "00:06:51,880"
			},
			"offsets": {
				"from": 409920,
				"to": 411880
			},
			"text": "我们认为它的一个统计学效能"
		},
		{
			"timestamps": {
				"from": "00:06:51,880",
				"to": "00:06:52,720"
			},
			"offsets": {
				"from": 411880,
				"to": 412720
			},
			"text": "是不足的"
		},
		{
			"timestamps": {
				"from": "00:06:52,720",
				"to": "00:06:55,440"
			},
			"offsets": {
				"from": 412720,
				"to": 415440
			},
			"text": "洪同学用到了这家SNP"
		},
		{
			"timestamps": {
				"from": "00:06:55,440",
				"to": "00:06:58,720"
			},
			"offsets": {
				"from": 415440,
				"to": 418720
			},
			"text": "它的F值其实都是小于10的"
		},
		{
			"timestamps": {
				"from": "00:06:58,720",
				"to": "00:07:00,720"
			},
			"offsets": {
				"from": 418720,
				"to": 420720
			},
			"text": "F值在MF分析中"
		},
		{
			"timestamps": {
				"from": "00:07:00,720",
				"to": "00:07:01,720"
			},
			"offsets": {
				"from": 420720,
				"to": 421720
			},
			"text": "它小于10的话"
		},
		{
			"timestamps": {
				"from": "00:07:01,720",
				"to": "00:07:02,800"
			},
			"offsets": {
				"from": 421720,
				"to": 422800
			},
			"text": "那就不能用"
		},
		{
			"timestamps": {
				"from": "00:07:02,800",
				"to": "00:07:03,680"
			},
			"offsets": {
				"from": 422800,
				"to": 423680
			},
			"text": "5乘10的-8"
		},
		{
			"timestamps": {
				"from": "00:07:03,680",
				"to": "00:07:06,200"
			},
			"offsets": {
				"from": 423680,
				"to": 426200
			},
			"text": "这个算是我们普遍的金标准"
		},
		{
			"timestamps": {
				"from": "00:07:06,200",
				"to": "00:07:07,320"
			},
			"offsets": {
				"from": 426200,
				"to": 427320
			},
			"text": "我们要满足这个标准"
		},
		{
			"timestamps": {
				"from": "00:07:07,320",
				"to": "00:07:08,480"
			},
			"offsets": {
				"from": 427320,
				"to": 428480
			},
			"text": "我们才能认为"
		},
		{
			"timestamps": {
				"from": "00:07:08,480",
				"to": "00:07:11,720"
			},
			"offsets": {
				"from": 428480,
				"to": 431720
			},
			"text": "这个SNP和暴露之间是密切相关的"
		},
		{
			"timestamps": {
				"from": "00:07:11,720",
				"to": "00:07:13,680"
			},
			"offsets": {
				"from": 431720,
				"to": 433680
			},
			"text": "就简单说洪同学这篇文章"
		},
		{
			"timestamps": {
				"from": "00:07:13,680",
				"to": "00:07:15,920"
			},
			"offsets": {
				"from": 433680,
				"to": 435920
			},
			"text": "其实能揪出的问题还挺多的"
		}
	]
}
